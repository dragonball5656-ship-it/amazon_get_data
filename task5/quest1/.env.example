# Slack Bot Token (xoxb- で始まる)。Bot に channels:history と users:read 権限が必要。
SLACK_BOT_TOKEN=xoxb-your-bot-token

# 取得対象チャンネルのID (C で始まる)。チャンネル名を右クリック→「リンクをコピー」末尾のID。
SLACK_CHANNEL_ID=C0123456789

# LINE Messaging API のチャネルアクセストークン (長期)
LINE_CHANNEL_ACCESS_TOKEN=your-line-channel-access-token

# 送信先のユーザーID または グループID (U... / C...)
LINE_TO=Uxxxxxxxxxxxxxxxx

# Anthropic API キー
ANTHROPIC_API_KEY=sk-ant-your-api-key

# 要約対象とする直近の時間数 (省略時は24)
SUMMARY_HOURS=24
